---
import Layout from '../layouts/Layout.astro';
import AyahDemo from '../components/AyahDemo.astro';

const GH = 'https://github.com/estiaksoyeb/AyahFlow';
const RELEASES = GH + '/releases';

// Fetch the latest release at build time so the download button stays accurate.
// Falls back to the stable "latest" URL if the API is unavailable.
const STABLE_APK = GH + '/releases/latest/download/app-release.apk';
let release = { url: STABLE_APK, version: null, sizeMb: null };
try {
  const res = await fetch('https://api.github.com/repos/estiaksoyeb/AyahFlow/releases/latest', {
    headers: { 'Accept': 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = await res.json();
    const apk = data.assets?.find((a) => a.name.endsWith('.apk'));
    if (apk) {
      release.url = apk.browser_download_url;
      release.version = data.tag_name;
      release.sizeMb = (apk.size / (1024 * 1024)).toFixed(1);
    }
  }
} catch (e) {
  // Keep fallbacks
}

const features = [
  { icon: '📖', title: 'একবারে একটি আয়াত', body: 'প্রতিটি স্ক্রিনে একটি আয়াত। উপরে সোয়াইপ করলেই পরের আয়াত। পাতা উল্টানো বা খোঁজাখুঁজি নেই।' },
  { icon: '🔁', title: 'পড়ার ধারাবাহিকতা', body: 'অ্যাপ আপনার শেষ অবস্থান মনে রাখে। যেখানে থেমেছিলেন, ঠিক সেখান থেকেই আবার শুরু।' },
  { icon: '🎯', title: 'দৈনিক লক্ষ্য', body: 'প্রতিদিন ১০, ২০ বা ৩০ আয়াতের লক্ষ্য ঠিক করুন। আজকের অগ্রগতি আর খতম শেষ হওয়ার আনুমানিক সময় দেখুন।' },
  { icon: '🔔', title: 'দৈনিক রিমাইন্ডার', body: 'দিনের নির্দিষ্ট সময়ে ছোট একটি নোটিফিকেশন, সাথে আপনার সর্বশেষ অবস্থান।' },
  { icon: '🔖', title: 'বুকমার্ক ও ক্যাটাগরি', body: 'প্রিয় আয়াত সংরক্ষণ করুন, ক্যাটাগরি অনুযায়ী সাজান।' },
  { icon: '🔍', title: 'সহায়ক সব টুল', body: 'সার্চ, সূরা নির্বাচক, টীকা ও ব্যাখ্যা, শেষ পঠিত — সব একই জায়গায়।' },
  { icon: '🌐', title: 'বাংলা অনুবাদ', body: 'সম্পূর্ণ বাংলা ইন্টারফেস। চাইলে আরবি ও ইংরেজি অনুবাদও সাথে দেখুন।' },
  { icon: '🖼️', title: 'ছবি হিসেবে শেয়ার', body: 'যেকোনো আয়াত সুন্দর ছবি বা টেক্সট হিসেবে শেয়ার করুন।' },
];
---
<Layout>
  <!-- HERO -->
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-16 pb-20 md:grid-cols-[1.05fr_1fr]">
    <div class="bn">
      <span class="inline-block rounded-full bg-primary-container px-3 py-1 text-xs font-bold text-on-primary-container">বাংলা অনুবাদসহ · Android</span>
      <h1 class="mt-5 text-4xl font-bold leading-tight md:text-5xl">
        প্রতিদিন <span class="text-emerald-ink">একটি আয়াত</span>।<br/>নিয়মিত, ক্রমানুসারে।
      </h1>
      <p class="mt-5 max-w-[52ch] text-lg text-on-variant">
        উপরে সোয়াইপ করলেই পরের আয়াত। পাতা উল্টানো নেই, খোঁজাখুঁজি নেই। অল্প করে, প্রতিদিন — এই ছোট অভ্যাসটাই এখানে সবচেয়ে জরুরি।
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={release.url} class="bn rounded-xl bg-emerald-ink px-6 py-3 font-bold text-white no-underline shadow hover:opacity-90">
          সর্বশেষ APK ডাউনলোড{release.sizeMb ? ` · ${release.sizeMb}MB` : ''}
        </a>
        <a href={GH} class="rounded-xl border border-outline-soft px-6 py-3 font-semibold text-on-surface no-underline hover:bg-variant/60">GitHub-এ দেখুন</a>
      </div>
      <p class="mt-4 text-sm text-on-variant">ওপেন সোর্স · বিজ্ঞাপনমুক্ত · কোনো অ্যাকাউন্ট লাগে না</p>
    </div>
    <div id="preview" class="scroll-mt-24">
      <AyahDemo />
      <p class="mt-4 text-center text-sm text-on-variant">এটি অ্যাপের আসল পাঠ-স্ক্রিনের একটি জীবন্ত প্রিভিউ — স্ক্রল করে দেখুন।</p>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="scroll-mt-24 border-t border-outline-soft/55 bg-surface/40 py-20">
    <div class="bn mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold md:text-4xl">যা যা আছে</h2>
      <p class="mt-3 max-w-[60ch] text-on-variant">ছোট ছোট ব্যবহারিক সুবিধা, যাতে প্রতিদিনের পাঠটি সহজ আর টেকসই হয়।</p>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {features.map((f) => (
          <div class="rounded-3xl border border-outline-soft/60 bg-surface p-6 shadow-sm transition hover:shadow-md">
            <div class="grid h-11 w-11 place-items-center rounded-2xl bg-primary-container text-xl">{f.icon}</div>
            <h3 class="mt-4 font-bold text-on-surface">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-on-variant">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="py-20">
    <div class="bn mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold md:text-4xl">কীভাবে কাজ করে</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {[
          { n: '১', t: 'লক্ষ্য বাছুন', d: 'প্রতিদিন ১০, ২০ বা ৩০ আয়াত — যেটা আপনার জন্য টেকসই।' },
          { n: '২', t: 'উপরে সোয়াইপ করুন', d: 'প্রতিটি আয়াত পড়ে উপরে সোয়াইপ করলেই পরের আয়াত।' },
          { n: '৩', t: 'নিয়মিত থাকুন', d: 'রিমাইন্ডার আর ধারাবাহিকতা আপনার অভ্যাস ধরে রাখবে।' },
        ].map((s) => (
          <div>
            <div class="grid h-12 w-12 place-items-center rounded-2xl bg-emerald-ink text-lg font-bold text-white">{s.n}</div>
            <h3 class="mt-4 text-lg font-bold">{s.t}</h3>
            <p class="mt-2 text-on-variant">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DOWNLOAD CTA -->
  <section class="mx-auto max-w-6xl px-6 pb-4">
    <div class="bn rounded-[32px] bg-emerald-ink px-8 py-14 text-center text-white md:px-16">
      <h2 class="text-3xl font-bold md:text-4xl">আজই শুরু করুন</h2>
      <p class="mx-auto mt-3 max-w-[52ch] text-white/85">নতুন সংস্করণ GitHub Releases পেজে প্রকাশিত হয়। APK নামিয়ে সরাসরি ইনস্টল করুন।</p>
      <a href={release.url} class="bn mt-8 inline-block rounded-xl bg-white px-7 py-3 font-bold text-emerald-ink no-underline hover:opacity-90">
        {release.version ? `AyahFlow ${release.version} ডাউনলোড করুন` : 'সর্বশেষ APK ডাউনলোড'}
      </a>
    </div>
  </section>
</Layout>

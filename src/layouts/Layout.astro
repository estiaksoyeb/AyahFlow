---
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const {
  title = 'AyahFlow — প্রতিদিন অল্প করে কুরআন',
  description = 'AyahFlow বাংলা ভাষাভাষীদের জন্য তৈরি একটি ফ্রি কুরআন অ্যাপ, যা আপনাকে প্রতিদিন অল্প করে কুরআন পড়ার অভ্যাস গড়তে সাহায্য করবে। পাতা উল্টানো বা লাইন খোঁজার ঝামেলা ছাড়াই এতে স্ক্রিনজুড়ে এক বারে একটি করে আয়াত দেখা যায়—উপরে সোয়াইপ করলেই আসে পরের আয়াত। আপনার প্রতিদিনের লক্ষ্য, রিমাইন্ডার এবং শেষ কতটুকু পড়েছিলেন তার হিসাব অ্যাপটি নিজেই মনে রাখে। কোনো বিজ্ঞাপন নেই, অ্যাকাউন্ট খোলার ঝামেলা নেই, আর ইন্টারনেট ছাড়া অফলাইনেও চলে।',
} = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const GH = 'https://github.com/estiaksoyeb/AyahFlow';
const RELEASES = GH + '/releases';
---
<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <link rel="icon" href={`${BASE}/favicon.ico`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#121614" />
  </head>
  <body class="min-h-screen bg-bg text-on-surface font-sans">
    <header class="sticky top-0 z-20 border-b border-outline-soft/55 bg-bg/80 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <a href={`${BASE}/`} class="flex shrink-0 items-center gap-2.5 font-bold text-lg text-on-surface no-underline">
          <img src={`${BASE}/logo.png`} alt="AyahFlow" width="32" height="32" class="h-8 w-8 rounded-[9px]" />
          <span>AyahFlow</span>
        </a>
        <nav class="bn hidden items-center gap-5 text-[15px] sm:flex">
          <a href="#features" class="whitespace-nowrap text-on-variant hover:text-emerald-ink no-underline">কী কী আছে</a>
          <a href="#preview" class="whitespace-nowrap text-on-variant hover:text-emerald-ink no-underline">প্রিভিউ</a>
          <a href={RELEASES} class="whitespace-nowrap text-on-variant hover:text-emerald-ink no-underline">ডাউনলোড</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="mt-20 border-t border-outline-soft/55 py-9 text-sm text-on-variant">
      <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-6 px-6">
        <div>
          <strong class="text-on-surface">AyahFlow</strong>
          <p class="bn mt-1.5 max-w-[44ch]">প্রতিদিন অল্প করে, ধারাবাহিকভাবে কুরআন পড়ার জন্য একটি ফ্রি অ্যাপ।</p>
        </div>
        <div class="bn flex items-center gap-[18px]">
          <a href={RELEASES} class="text-on-variant hover:text-emerald-ink no-underline">সব সংস্করণ</a>
          <a href={GH} class="text-on-variant/70 hover:text-emerald-ink no-underline text-xs">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
